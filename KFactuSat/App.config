<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
	</startup>
	<system.serviceModel>
		<client>
			<!--Testing-->
			<endpoint address="https://testing.solucionfactible.com/ws/services/Timbrado"
			 binding="basicHttpBinding" bindingConfiguration="TimbradoSoap11Binding_TESTING"
			 contract="com.sf.ws.Timbrado.TimbradoPortType" name="TimbradoEndpoint_TESTING" />
			<endpoint address="https://testing.solucionfactible.com/ws/services/Utilerias"
			 binding="basicHttpBinding" bindingConfiguration="UtileriasSoap11Binding_TESTING"
			 contract="com.sf.ws.Utilerias.UtileriasPortType" name="UtileriasEndpoint_TESTING" />
			<!--Produccion-->
			<endpoint address="https://solucionfactible.com/ws/services/Timbrado"
			 binding="basicHttpBinding" bindingConfiguration="TimbradoSoap11Binding_PRODUCCION"
			 contract="com.sf.ws.Timbrado.TimbradoPortType" name="TimbradoEndpoint_PRODUCCION" />
			<endpoint address="https://solucionfactible.com/ws/services/Utilerias"
			 binding="basicHttpBinding" bindingConfiguration="UtileriasSoap11Binding_PRODUCCION"
			 contract="com.sf.ws.Utilerias.UtileriasPortType" name="UtileriasEndpoint_PRODUCCION" />
		</client>
		<bindings>
			<basicHttpBinding>
				<binding name="TimbradoSoap11Binding_PRODUCCION" maxBufferSize="10485760"
				 maxReceivedMessageSize="10485760">
					<readerQuotas maxDepth="64" maxStringContentLength="10485760"
					 maxArrayLength="10485760" maxBytesPerRead="4096" maxNameTableCharCount="10485760" />
					<security mode="Transport">
						<transport clientCredentialType="None" />
					</security>
				</binding>
				<binding name="TimbradoSoap11Binding_TESTING" maxBufferSize="10485760"
				 maxReceivedMessageSize="10485760">
					<readerQuotas maxDepth="64" maxStringContentLength="10485760"
					 maxArrayLength="10485760" maxBytesPerRead="4096" maxNameTableCharCount="10485760" />
					<security mode="Transport">
						<transport clientCredentialType="None" />
					</security>
				</binding>
				<binding name="UtileriasSoap11Binding_PRODUCCION" maxBufferSize="10485760"
				 maxReceivedMessageSize="10485760">
					<readerQuotas maxDepth="64" maxStringContentLength="10485760"
					 maxArrayLength="10485760" maxBytesPerRead="4096" maxNameTableCharCount="10485760" />
					<security mode="Transport">
						<transport clientCredentialType="None" />
					</security>
				</binding>
				<binding name="UtileriasSoap11Binding_TESTING" maxBufferSize="10485760"
				 maxReceivedMessageSize="10485760">
					<readerQuotas maxDepth="64" maxStringContentLength="10485760"
					 maxArrayLength="10485760" maxBytesPerRead="4096" maxNameTableCharCount="10485760" />
					<security mode="Transport">
						<transport clientCredentialType="None" />
					</security>
				</binding>
			</basicHttpBinding>
		</bindings>
	</system.serviceModel>
</configuration>